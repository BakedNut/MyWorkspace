[Unit]
Description=MyWorkspace Spring Boot
After=network-online.target
Wants=network-online.target

[Service]
User=myworkspace
Group=myworkspace
WorkingDirectory=/var/lib/myworkspace
EnvironmentFile=/etc/myworkspace/application.env
ExecStart=/usr/bin/java -Xms64m -Xmx384m -XX:MaxMetaspaceSize=160m -XX:+ExitOnOutOfMemoryError -Djavax.net.ssl.trustStore=/etc/myworkspace/truststore.jks -Djavax.net.ssl.trustStorePassword=changeit -jar /opt/myworkspace/current.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryMax=700M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/myworkspace
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
